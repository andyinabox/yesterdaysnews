<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{ .PageTitle }}</title>

    {{ .MetaComment }}

    <meta name="description" content="yesterday's news" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="stylesheet" href="/assets/styles.css" />
    <script src="/assets/video-player.js"></script>
    <script src="/assets/event-button.js"></script>
    <script src="/assets/caption-display.js"></script>
    <script src="/assets/reloader.js"></script>

  </head>
  <body>

    <template id="yn-video-player-tpl">
      <video muted autoplay id="video">
        <source type="video/webm">
      </video>
    </template>

    <main id="main">
      <video muted autoplay id="video" data-resource-url="/clips">
        <source type="video/webm" src="{{ .InitialClipURL }}">
      </video>
      <caption-display resource-url="/captions"></caption-display>
    </main>

    <nav>
      <event-button event-name="yn-open-about" title="About this project">❓</event-button>
      <event-button event-name="yn-enter-fullscreen" title="About this project">🖥️</event-button>
    </nav>

    <dialog id="about">
      <event-button event-name="yn-close-about" title="Close about">❌</event-button>
      {{ .AboutContent }}
    </dialog>


    <script src="/assets/main.js"></script>
  </body>
</html>
